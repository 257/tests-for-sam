#!/usr/bin/env python

import enum
import json
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path
from types import SimpleNamespace
from typing import (IO, Any)
from collections.abc import Sequence

import semver  # requires dev-python/semver merged in stage3

sys.path.append("/work/src/mkosi")
from mkosi.log import (complete_step, log_notice, log_setup)
from mkosi.run import run, spawn

__prog__ = "userhook"
KERNEL_SRC = Path("/usr/src/linux")
KERNEL_SRC_CONFIG = KERNEL_SRC / ".config"
KERNEL_ETC = Path("/work/src/etc-kernel")

class HOOKNAMES(enum.StrEnum):
    # we're getting called in this order, don't change
    configure = enum.auto()
    # twice, once with `final` and once with `build` in argv[1]
    prepare = enum.auto()
    buildscript = 'build-script'

class STAGES(enum.StrEnum):
    final = enum.auto()
    build = enum.auto()

class TARGETS(enum.StrEnum):
    compile = ""
    distclean = enum.auto()
    clean = enum.auto()
    oldconfig = enum.auto()
    nconfig = enum.auto()
    modules_install = enum.auto()
    install = enum.auto()

Popen = subprocess.Popen[str]
PathString = Path | str
_FILE = None | int | IO[Any]

def run0() -> Sequence[str]:
    return ["run0", "--via-shell", "--background=", "--pty"]

def inlined_env(env: dict[str, str]) -> list[str]:
    return [f"{k}={v}" for k,v in env.items()]

def make(cfg: SimpleNamespace, target: TARGETS, env: dict[str, str] = {}) -> None:
    env = {"PATH":  "/bin:/usr/bin:/usr/sbin", # FIXME: we shouldn't need this
           "HOME": "/work/src", "TERM": "kitty-direct"} | env
    run(["make", "--jobs=16", *inlined_env(env), target], cwd=cfg.ksrc, env=env)

def _preserve_config(cfg: SimpleNamespace) -> None:
    shutil.copyfile(KERNEL_SRC_CONFIG, cfg.kcfg)

def _init_config(cfg: SimpleNamespace) -> None:
    shutil.copyfile(cfg.kcfg, KERNEL_SRC_CONFIG)

def kv_get_tip(krepo: Path) -> semver.Version:
    cmd = ["git", "for-each-ref", "--sort=-creatordate", "--format",
        "'%(refname:short)'", "refs/tags" ]
    log_notice(f"Discovering kernel's tip with `{' '.join(cmd)}`")
    with spawn(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                cwd=krepo) as p:
        out, err = p.communicate()

        release_tags = set()
        for t in shlex.split(out):
            # 2 series used to be proper semver with patch component, skip them
            if ('rc' in t or len(t.split('.')) != 2):
                continue
            candidate = t.strip("v")
            candidate = candidate.split('-')[0]
            release_tags.add(f"{candidate}.0")

    return max([semver.Version.parse(c) for c in release_tags])

def unpack(cfg: SimpleNamespace, distclean: bool = False) -> None:
    # FIXME: TODO: remove hardcoded paths
    cfg.krepo = Path("/work/src/linux.git")
    cfg.ksrc = Path("/usr/src/linux")
    kvtip = kv_get_tip(cfg.krepo)
    cfg.kv = f"v{kvtip.major}.{kvtip.minor}"
    cfg.kcfg = KERNEL_ETC / cfg.kv

    if cfg.ksrc.exists():
        kvtip_src = kv_get_tip(cfg.ksrc)
        if kvtip_src != kvtip:
            log_notice(f"(us) {kvtip_src} (upstream) {kvtip}")
            shutil.rmtree(cfg.ksrc)

    run(["git", "clone", "--branch", cfg.kv, "--depth", "1",
         cfg.krepo.as_uri()], check=False, cwd=cfg.ksrc.parent)
    run(["git", "checkout", cfg.kv], check=False, cwd=cfg.ksrc)

    return

def configure(cfg: SimpleNamespace, distclean: bool = False) -> None:
    if not cfg.Incremental:
        KERNEL_SRC_CONFIG.unlink(missing_ok=True)
        make(cfg, TARGETS.distclean)

    _init_config(cfg)
    # make(cfg, TARGETS.clean)
    make(cfg, TARGETS.oldconfig)
    # make(cfg, TARGETS.nconfig)
    _preserve_config(cfg)

    return

def compile(cfg: SimpleNamespace) -> None:
    return make(cfg, TARGETS.compile)

def modules_install(cfg: SimpleNamespace, p: Path) -> None:
    return make(cfg, TARGETS.modules_install, env={'INSTALL_MOD_PATH':
                                                   p.as_posix()})

def install(cfg: SimpleNamespace, p: Path) -> None:
    # TODO: pass /efi to this
    return make(cfg, TARGETS.install, env={'INSTALL_PATH': p.as_posix()})

def sync_portage_dir(cfg: SimpleNamespace):
    stage3_portage = Path("/etc/portage")
    with complete_step("syncing buildroot and and stage3's {stage3_portage}"):
        shutil.rmtree(stage3_portage, ignore_errors=True)
        installroot_portage = Path("/work/src/installroot") / "etc/portage"
        shutil.copytree(installroot_portage, stage3_portage,
                        ignore_dangling_symlinks=True,
                        ignore=shutil.ignore_patterns("sets", "repos.conf"),
                        dirs_exist_ok=True)

def kbuild(cfg: SimpleNamespace):
    unpack(cfg)
    configure(cfg)
    compile(cfg)

if __name__ == '__main__':
    log_setup()
    # this only matters for HOOKNAMES.configure case
    myname = Path(sys.argv[0]).name
    with complete_step(f"we are `{Path(sys.argv[0]).name}` hook"):
        match myname:
            case HOOKNAMES.configure:
                config = sys.stdin.read()
                cfg = json.loads(config, object_hook=lambda d: SimpleNamespace(**d))
                kbuild(cfg)
                sync_portage_dir(cfg)
                sys.stdout.write(config)
            case HOOKNAMES.prepare:
                stage = sys.argv[1]
                match stage:
                    case STAGES.build:
                        log_notice("""we're called in build overlay…""")
                        cfg = SimpleNamespace()
                        cfg.ksrc = KERNEL_SRC
                        modules_install(cfg, Path(f"{os.getenv('BUILDROOT')}/usr"))
                        install(cfg, Path(f"{os.getenv('SRCDIR')}/efi"))
                    case STAGES.final:
                        log_notice("to be implemented")
                    case _:
                        log_notice("this is a new stage by upstream!")
            case HOOKNAMES.buildscript:
                log_notice("to be implemented")
            case _:
                log_notice("this is a new hook by upstream!")

